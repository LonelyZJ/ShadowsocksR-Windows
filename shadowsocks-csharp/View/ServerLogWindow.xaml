<Window x:Class="Shadowsocks.View.ServerLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:valueConverter="clr-namespace:Shadowsocks.View.ValueConverter"
        xmlns:controls="clr-namespace:Shadowsocks.View.Controls"
        x:Name="Slw" >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../I18N/ServerLogWindow.en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <system:String x:Key="IndexMappingName">Index</system:String>
            <system:String x:Key="GroupMappingName">GroupName</system:String>
            <system:String x:Key="ServerMappingName">FriendlyName</system:String>
            <system:String x:Key="ConnectingMappingName">SpeedLog.Connecting</system:String>
            <system:String x:Key="AvgConnectTimeMappingName">SpeedLog.AvgConnectTimeText</system:String>
            <system:String x:Key="AvgDownloadBytesMappingName">SpeedLog.AvgDownloadBytesText</system:String>
            <system:String x:Key="MaxDownSpeedMappingName">SpeedLog.MaxDownSpeedText</system:String>
            <system:String x:Key="AvgUploadBytesMappingName">SpeedLog.AvgUploadBytesText</system:String>
            <system:String x:Key="MaxUpSpeedMappingName">SpeedLog.MaxUpSpeedText</system:String>
            <system:String x:Key="TotalDownloadBytesMappingName">SpeedLog.TotalDownloadBytesText</system:String>
            <system:String x:Key="TotalUploadBytesMappingName">SpeedLog.TotalUploadBytesText</system:String>
            <system:String x:Key="TotalDownloadRawBytesMappingName">SpeedLog.TotalDownloadRawBytesText</system:String>
            <system:String x:Key="ConnectErrorMappingName">SpeedLog.ConnectError</system:String>
            <system:String x:Key="ErrorTimeoutTimesMappingName">SpeedLog.ErrorTimeoutTimes</system:String>
            <system:String x:Key="ErrorEmptyTimesMappingName">SpeedLog.ErrorEmptyTimes</system:String>
            <system:String x:Key="ErrorContinuousTimesMappingName">SpeedLog.ErrorContinuousTimes</system:String>
            <system:String x:Key="ErrorPercentMappingName">SpeedLog.ErrorPercent</system:String>

            <valueConverter:SpeedToBrushConverter x:Key="SpeedToBrushConverter" />
            <valueConverter:ConnectNumberToBrushConverter x:Key="ConnectNumberToBrushConverter" />
            <valueConverter:LatencyToBrushConverter x:Key="LatencyToBrushConverter" />
            <valueConverter:ConnectErrorToBrushConverter x:Key="ConnectErrorToBrushConverter" />
            <valueConverter:ConnectEmptyToBrushConverter x:Key="ConnectEmptyToBrushConverter" />
            <valueConverter:ErrorPercentToBrushConverter x:Key="ErrorPercentToBrushConverter" />
            <valueConverter:BooleanToEnabledConverter x:Key="BooleanToEnabledConverter" />
            <valueConverter:TotalDownloadBackgroundBrushConvert x:Key="TotalDownloadBackgroundBrushConvert" />
            <valueConverter:TotalUploadBackgroundBrushConvert x:Key="TotalUploadBackgroundBrushConvert" />
            <valueConverter:TotalDownloadRawBackgroundBrushConvert x:Key="TotalDownloadRawBackgroundBrushConvert" />
            <SolidColorBrush x:Key="BorderBrush">#E5E5E5</SolidColorBrush>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="BorderBrush" Value="#808080" />
                <Setter Property="Background" Value="#CCCCCC" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
            <Style TargetType="{x:Type DataGridRowHeader}">
                <Setter Property="Background" Value="{Binding Path=Enable,Converter={StaticResource BooleanToEnabledConverter},Mode=OneWay}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
            <Style TargetType="{x:Type DataGridCell}" x:Key="BaseGridCell">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top" Background="White">
                <MenuItem Header="{DynamicResource Control}" >
                    <MenuItem Header="{DynamicResource DisconnectDirect}" Click="DisconnectDirectMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource DisconnectAll}" Click="DisconnectAllMenuItem_OnClick"/>
                    <Separator />
                    <MenuItem Header="{DynamicResource ClearMaxSpeed}" Click="ClearMaxMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource Clear}" Click="ClearAllMenuItem_OnClick"/>
                    <Separator />
                    <MenuItem Header="{DynamicResource ClearSelectedTotal}" Click="ClearSelectedTotalMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource ClearTotal}" Click="ClearTotalMenuItem_OnClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource PortOut}">
                    <MenuItem Header="{DynamicResource CopyCurrentLink}" Click="CopyCurrentLinkMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource CopyCurrentGroupLinks}" Click="CopyCurrentGroupLinksMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource CopyAllEnableLinks}" Click="CopyAllEnableLinksMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource CopyAllLinks}" Click="CopyAllLinksMenuItem_OnClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Window}">
                    <MenuItem Header="{DynamicResource AutoSize}" Click="AutoSizeMenuItem_OnClick"/>
                    <MenuItem Header="{DynamicResource AlwaysOnTop}" IsChecked="{Binding Topmost,ElementName=Slw}" Click="AlwaysTopMenuItem_OnClick"/>
                </MenuItem>
            </Menu>
            <DataGrid x:Name="ServerDataGrid"
                      DataContext="{Binding ServerLogViewModel, ElementName=Slw}"
                      ItemsSource="{Binding ServersCollection}"
                      AutoGenerateColumns="False"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0,1,0,0"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="All"
                      RowHeaderWidth="24"
                      ColumnHeaderHeight="25"
                      AlternationCount="2"
                      MouseLeftButtonUp="ServerDataGrid_OnMouseLeftButtonUp"
                      MouseDoubleClick="ServerDataGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Index}" Binding="{Binding Index}" SortMemberPath="Index" controls:DataGridColumnAutoSizer.MappingName="{StaticResource IndexMappingName}" />

                    <DataGridTextColumn Header="{DynamicResource Group}" Binding="{Binding GroupName}" SortMemberPath="GroupName" controls:DataGridColumnAutoSizer.MappingName="{StaticResource GroupMappingName}" />

                    <DataGridTextColumn Header="{DynamicResource Server}" Binding="{Binding FriendlyName}" SortMemberPath="FriendlyName" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ServerMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected,Mode=OneWay}" Value="True">
                                        <Setter Property="Background" Value="#FF00FFAA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Connecting}" Binding="{Binding SpeedLog.Connecting}" SortMemberPath="SpeedLog.Connecting" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ConnectingMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                Value="{Binding Path=SpeedLog.Connecting,Converter={StaticResource ConnectNumberToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Latency}" Binding="{Binding SpeedLog.AvgConnectTimeText}" SortMemberPath="SpeedLog.AvgConnectTimeText" controls:DataGridColumnAutoSizer.MappingName="{StaticResource AvgConnectTimeMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding Path=SpeedLog.AvgConnectTimeText,Converter={StaticResource LatencyToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource AvgDSpeed}" Binding="{Binding SpeedLog.AvgDownloadBytesText}" SortMemberPath="SpeedLog.AvgDownloadBytes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource AvgDownloadBytesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                Value="{Binding SpeedLog.AvgDownloadBytes,Converter={StaticResource SpeedToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource MaxDSpeed}" Binding="{Binding SpeedLog.MaxDownSpeedText}" SortMemberPath="SpeedLog.MaxDownSpeed" controls:DataGridColumnAutoSizer.MappingName="{StaticResource MaxDownSpeedMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background" 
                                Value="{Binding SpeedLog.MaxDownSpeed,Converter={StaticResource SpeedToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource AvgUpSpeed}" Binding="{Binding SpeedLog.AvgUploadBytesText}" SortMemberPath="SpeedLog.AvgUploadBytes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource AvgUploadBytesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.AvgUploadBytes,Converter={StaticResource SpeedToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource MaxUpSpeed}" Binding="{Binding SpeedLog.MaxUpSpeedText}" SortMemberPath="SpeedLog.MaxUpSpeed" controls:DataGridColumnAutoSizer.MappingName="{StaticResource MaxUpSpeedMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.MaxUpSpeed,Converter={StaticResource SpeedToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Dload}" Binding="{Binding SpeedLog.TotalDownloadBytesText}" SortMemberPath="SpeedLog.TotalDownloadBytes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource TotalDownloadBytesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background" Value="{Binding Path=(ItemsControl.AlternationIndex),RelativeSource={RelativeSource AncestorType=DataGridRow},Converter={StaticResource TotalDownloadBackgroundBrushConvert},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Upload}" Binding="{Binding SpeedLog.TotalUploadBytesText}" SortMemberPath="SpeedLog.TotalUploadBytes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource TotalUploadBytesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background" Value="{Binding Path=(ItemsControl.AlternationIndex),RelativeSource={RelativeSource AncestorType=DataGridRow},Converter={StaticResource TotalUploadBackgroundBrushConvert},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource DloadRaw}" Binding="{Binding SpeedLog.TotalDownloadRawBytesText}" SortMemberPath="SpeedLog.TotalDownloadRawBytes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource TotalDownloadRawBytesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background" Value="{Binding Path=(ItemsControl.AlternationIndex),RelativeSource={RelativeSource AncestorType=DataGridRow},Converter={StaticResource TotalDownloadRawBackgroundBrushConvert},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Error}" Binding="{Binding SpeedLog.ConnectError}" SortMemberPath="SpeedLog.ConnectError" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ConnectErrorMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.ConnectError,Converter={StaticResource ConnectErrorToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Timeout}" Binding="{Binding SpeedLog.ErrorTimeoutTimes}" SortMemberPath="SpeedLog.ErrorTimeoutTimes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ErrorTimeoutTimesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.ErrorTimeoutTimes,Converter={StaticResource ConnectEmptyToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource EmptyResponse}" Binding="{Binding SpeedLog.ErrorEmptyTimes}" SortMemberPath="SpeedLog.ErrorEmptyTimes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ErrorEmptyTimesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.ErrorEmptyTimes,Converter={StaticResource ConnectEmptyToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource Continuous}" Binding="{Binding SpeedLog.ErrorContinuousTimes}" SortMemberPath="SpeedLog.ErrorContinuousTimes" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ErrorContinuousTimesMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.ErrorContinuousTimes,Converter={StaticResource ConnectEmptyToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="{DynamicResource ErrorPercent}" Binding="{Binding SpeedLog.ErrorPercent, StringFormat={}{0:0}%, TargetNullValue=0%}" SortMemberPath="SpeedLog.ErrorPercent" controls:DataGridColumnAutoSizer.MappingName="{StaticResource ErrorPercentMappingName}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseGridCell}">
                                <Setter Property="Background"
                                        Value="{Binding SpeedLog.ErrorPercent,Converter={StaticResource ErrorPercentToBrushConverter},Mode=OneWay}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Grid>
</Window>
